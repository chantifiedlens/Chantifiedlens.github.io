<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ description or site.description }}">
  <meta name="theme-color" content="#11352e">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ title }} · {{ site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <title>{{ title }} · {{ site.name }}</title>
  <link rel="stylesheet" href="{{ '/assets/styles.css' | url }}">
  <script src="{{ '/assets/catalog.js' | url }}" defer></script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="header-inner">
      <a class="brand" href="{{ '/' | url }}" aria-label="Chantified Lens home"><span class="brand-mark" aria-hidden="true">CL<span>.</span></span><span>Chantified<span class="brand-second">Lens</span></span></a>
      <nav class="main-nav" aria-label="Main navigation">
        <a href="{{ '/' | url }}" {% if page.url == '/' %}aria-current="page"{% endif %}>Overview</a>
        <a href="{{ '/repositories/' | url }}" {% if page.url == '/repositories/' %}aria-current="page"{% endif %}>Repositories</a>
        <a href="{{ '/#technologies' | url }}">Technologies</a>
        <a href="{{ '/#getting-started' | url }}">Getting started</a>
      </nav>
      <a class="header-github" href="{{ site.githubUrl }}" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
    </div>
  </header>
  <main id="main" tabindex="-1">{{ content | safe }}</main>
  <footer class="site-footer">
    <div class="footer-top"><div><a class="footer-brand" href="{{ '/' | url }}">Chantified Lens<span>.</span></a><p>Practical solutions. Shared openly.</p></div><nav aria-label="Footer navigation"><a href="{{ '/repositories/' | url }}">Repository catalog</a><a href="{{ '/#resources' | url }}">Official documentation</a><a href="{{ site.githubUrl }}" target="_blank" rel="noopener noreferrer">GitHub ↗<span class="sr-only"> (opens in a new tab)</span></a></nav></div>
    <div class="footer-bottom"><p>Repository data retrieved <time datetime="{{ catalog.fetchedAt }}">{{ catalog.fetchedAt | dateLabel }}</time> · Updated automatically</p><p>Independent community resource. Not affiliated with Microsoft or GitHub.</p></div>
    {% if catalog.stale %}<p class="freshness-notice">Showing the last successful repository snapshot. GitHub data may have changed since {{ catalog.fetchedAt | dateLabel }}.</p>{% endif %}
  </footer>
</body>
</html>